# --- RAG service (exposes POST /search) ---
RAG_SERVICE_URL=http://localhost:8000

# --- Served model: any OpenAI-compatible endpoint with tool calling ---
# Development: OpenRouter. Production: vLLM's OpenAI-compatible server
# (needs --enable-auto-tool-choice --tool-call-parser hermes). Only these three change.
MODEL_SERVICE_URL=https://openrouter.ai/api/v1
MODEL_NAME=inclusionai/ling-3.0-flash:free
MODEL_API_KEY=

# --- MCP shop server, spawned over stdio by the actions agent ---
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=--directory,/path/to/mcp-shop-server,run,mcp-shop-server

# --- Supervisor guardrails ---
AGENT_STEP_CAP=8
