# --- RAG specialist: the_rag_project's FastAPI service ---
# TODO: confirm the actual host:port the_rag_project's `rag/api/main.py` binds to
RAG_SERVICE_URL=http://localhost:8000

# --- Served model ---
# For now: OpenRouter free model (dev, no GPU needed).
# Later, to satisfy C5, point these at vLLM's OpenAI-compatible endpoint instead
# (from vLLM/src/serve.py / slurm/serve.sbatch) -- same client code, just swap these three.
MODEL_SERVICE_URL=https://openrouter.ai/api/v1
MODEL_NAME=inclusionai/ling-3.0-flash:free
MODEL_API_KEY=

# --- MCP actions specialist: spawns the_mcp_project server over stdio ---
# TODO: confirm this matches how `uv run mcp-shop-server` resolves from this machine
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=--directory,/home/s2799210/llm_projects/MCP/the_mcp_project,run,mcp-shop-server

# --- Supervisor guardrails ---
AGENT_STEP_CAP=8

# --- Anthropic key, only if the supervisor's routing LLM is Claude rather than the served model ---
# ANTHROPIC_API_KEY=
